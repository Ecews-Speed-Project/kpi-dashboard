# Copy to .env and fill in. Never commit .env or share it. Only NAME=value lines.
DHIS2_WEEKLY_USER=
DHIS2_WEEKLY_PASS=
DHIS2_MONTHLY_USER=
DHIS2_MONTHLY_PASS=
PG_HOST=
PG_USER=
PG_PASS=

# Optional (server): sign-in cookie key; if empty, data/.dash_secret is created and kept
DASH_SECRET=

# Optional (server job): e-mail when a scheduled update fails, and when it works again
ALERT_TO=
ALERT_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
